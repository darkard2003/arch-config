// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "window_decorations": "server",
  "tabs": {
    "close_position": "left"
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": false
  },
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "edit_predictions": {
    "mode": "subtle",
    "ollama": {
      "api_url": "http://darkmac:11434",
      "max_output_tokens": 128,
      "prompt_format": "qwen",
      "model": "qwen2.5-fast-complete-mini:latest",
    },
    "provider": "zed",
  },
  "icon_theme": "Catppuccin Mocha",
  "languages": {
    "Java": {
      "show_edit_predictions": true
    },
    "JSONC": {
      "show_edit_predictions": false,
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "templ": "html",
        },
      },
    },
  },
  "ssh_connections": [
    {
      "host": "darkmac.local",
      "args": [],
      "projects": [
        {
          "paths": ["/Users/dark/code/golang"],
        },
        {
          "paths": ["/Users/dark/code/project/depression"],
        },
      ],
    },
  ],
  "disable_ai": false,
  "agent": {
    "dock": "right",
    "favorite_models": [
      {
        "provider": "ollama",
        "model": "qwen3.5-coder",
        "enable_thinking": false
      }
    ],
    "default_profile": "ask",
    "default_model": {
      "effort": "low",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "gemini-3-flash-preview",
    },
    "model_parameters": [],
  },
  "language_models": {
    "ollama": {
      "api_url": "http://darkmac:11434",
      "available_models": [
        {
          "name": "qwen3.5-coder",
          "display_name": "Qwen Coder (Tools)",
          "max_tokens": 32768,
          "supports_tools": true,
          "supports_images": true,
          "supports_thinking": true,
        },
      ],
    },
  },
  "vim_mode": true,
  "terminal": {
    "font_size": 12.0,
    "font_family": "JetBrainsMono Nerd Font",
  },
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "sticky_scroll": {
    "enabled": false,
  },
  "gutter": {
    "line_numbers": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_fallbacks": ["Droid Sans Mono", "monospace", "monospace"],
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "show_edit_predictions": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Catppuccin Mocha",
  },
}
