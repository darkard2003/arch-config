# Swaylock Configuration Template
# This file uses placeholders that will be replaced by the Bash script
# with colors generated by Pywal.

# Background image - the script will generate a blurred version of your wallpaper
# and use its path here.
image=/home/dark/arch-config/swaylock/lockscreen_blur.png
scaling=fill

# Indicator appearance
indicator-thickness=10
indicator-radius=50
font=sans-serif
font-size=24

# Colors are in RRGGBBAA format (RedGreenBlueAlpha)
# Alpha values: FF = fully opaque, BB = ~75% opaque, 00 = fully transparent

# Inside color of the indicator
inside-color=090404BB
inside-clear-color=6E6A6ABB  # Example: a lighter accent color when cleared
inside-caps-lock-color=9F837CBB # Example: another accent color for caps lock
inside-ver-color=9A4443BB    # Example: a success color
inside-wrong-color=475666BB   # Example: an error color

# Ring color of the indicator
ring-color=090404FF
ring-clear-color=6E6A6AFF
ring-caps-lock-color=9F837CFF
ring-ver-color=9A4443FF
ring-wrong-color=475666FF

# Line color (between inside and ring)
line-color=090404FF
line-clear-color=6E6A6AFF
line-caps-lock-color=9F837CFF
line-ver-color=9A4443FF
line-wrong-color=475666FF

# Text color (for password input, layout, etc.)
text-color=C1C0C0FF
text-clear-color=C1C0C0FF
text-caps-lock-color=C1C0C0FF
text-ver-color=C1C0C0FF
text-wrong-color=C1C0C0FF

# Highlight colors for key presses
key-hl-color=A09D9CFF
bs-hl-color=475666FF
separator-color=00000000 # Transparent separator

# Layout text (e.g., keyboard layout indicator)
layout-text-color=C1C0C0FF
layout-bg-color=090404BB
layout-border-color=090404FF

# Other options you might want:
# show-failed-attempts
# indicator-idle-visible
# no-unlock-indicator
# show-keyboard-layout
# hide-keyboard-layout
# disable-caps-lock-text
# indicator-caps-lock
